GOOGLE_API_KEY=AIzaSyAg1JyuqT0dFwwkjwCR_-7SOMpjTATRMOs
SECRET_KEY=key
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=False
MODEL_NAME=gemini-2.5-flash

# Qdrant Configuration (local file-based storage)
QDRANT_PATH=./qdrant_data

# ============================================
# 🌐 Web Retrieval Configuration
# ============================================

# Abilita la ricerca sul web per confronti e aggiornamenti
ENABLE_WEB_RETRIEVAL=true

# Timeout massimo per ogni richiesta web (in secondi)
WEB_TIMEOUT_SEC=8

# 🔧 Comportamento avanzato del retriever
WEB_STRICT_ALLOWLIST=false     # false = accetta anche siti non in allowlist (esclusi quelli bloccati)
WEB_REGION=it-it               # ricerca focalizzata sull'Italia
WEB_SAFESEARCH=moderate        # off | moderate | strict
WEB_TIME_LIMIT=m               # risultati del mese (opzionale)
WEB_DEBUG_LOG=true             # stampa log query e risultati

# Lista domini ammessi (se vuoi restringere)
WEB_ALLOWED_DOMAINS=

# Lista domini bloccati (sempre esclusi)
WEB_BLOCKED_DOMAINS=reddit.,quora.,pinterest.,facebook.,instagram.,tiktok.,x.com,twitter.com,youtube.

# 🗄️ Database Configuration
DATABASE_URL=sqlite:///data.db

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=business_project
QDRANT_READONLY=true